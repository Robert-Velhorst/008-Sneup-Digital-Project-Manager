  },
  "license": "MIT",
  "files": [
    "index.js"
  ],
  "main": "index.js",
  "engines": {
    "node": ">=26.12.1 <27"
  },
  "scripts": {
    "test": "mocha"
  },
  "dependencies": {
    "git-config-path": "2.0.0",
    "ini": "7.0.0"
  },
  "devDependencies": {
    "gulp-format-md": "2.0.0",
