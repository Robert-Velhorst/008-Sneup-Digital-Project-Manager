{
  "name": "node-schedule",
  "version": "2.1.2",
  "description": "A cron-like and not-cron-like job scheduler for Node.",
  "keywords": [
    "schedule",
    "task",
    "job",
    "cron",
    "recurrent",
    "in-memory"
  ],
  "license": "MIT",
  "main": "index.js",
  "scripts": {
    "test": "tape test/*.js",
    "test:browser": "airtap test/cancel-long-running-jobs.js test/convenience-method-test.js test/date-convenience-methods-test.js test/range-test.js test/recurrence-rule-test.js test/schedule-cron-jobs.js test/start-end-test.js",
    "coveralls": "nyc report --reporter=lcov",
    "test:coverage": "nyc tape test/*.js",
    "lint": "eslint lib test",
    "lint:fix": "eslint --fix lib test",
    "changeset": "changeset",
    "release": "changeset publish"
  },
  "author": {
    "name": "Matt Patenaude",
    "email": "matt@mattpatenaude.com",
    "url": "http://mattpatenaude.com"
  },
  "contributors": [
    {
      "name": "Igor Savin",
      "email": "kibertoad@gmail.com"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/node-schedule/node-schedule.git"
  },
  "dependencies": {
    "cron-parser": "5.10.2",
    "long-timeout": "0.1.1",
    "sorted-array-functions": "1.3.0"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "airtap": "5.0.0",
    "airtap-playwright": "1.0.1",
    "eslint": "10.13.0",
    "nyc": "18.0.0",
    "sinon": "22.1.0",
    "tape": "5.10.3",
    "@eslint/js": "10.0.1",
    "globals": "17.13.0",
    "@stylistic/eslint-plugin": "5.10.0"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "CHANGELOG.md",
    "README.md",
    "UPGRADING.md",
    "LICENSE",
    "lib/*"
  ],
  "private": true,
  "x-noodzakelijk-compatibility-port": {
    "upstreamVersion": "2.1.2",
    "upstreamCommit": "6d5ad4b31dc5fc530a810489f482dd59cabc9803",
    "publicUpstreamRelease": false,
    "description": "Private local source port to cron-parser public 5.x APIs; upstream version retained for provenance, not a new official release."
  }
}
