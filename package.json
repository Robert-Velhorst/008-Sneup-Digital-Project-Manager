{
  "name": "sneup",
  "version": "2.3.78",
  "description": "Autonomous AI-powered digital project manager for Trello v2.0 - proactive management, performance tracking, conversational AI, and accountability enforcement",
  "main": "desktop/main.js",
  "scripts": {
    "start": "node src/index.js",
    "start:cloud": "node scripts/start-cloud.js",
    "verify:cloud-container": "node scripts/verify-cloud-container.js",
    "desktop": "electron .",
    "build:installer": "electron-builder --win nsis --x64 --publish never",
    "dist:win": "npm run build:installer",
    "dev": "node --watch src/index.js",
    "migrate:workspace": "node scripts/migrate-workspace-scope.js",
    "repair:data": "node scripts/repair-data-integrity.js",
    "evaluate:recommendations": "node scripts/evaluate-recommendations.js",
    "check:route-authorization": "node scripts/verify-route-authorization.js",
    "check:release-security": "node scripts/verify-release-security.js",
    "verify:workspace-deletion": "node scripts/verify-workspace-deletion.js",
    "verify:workspace-invitations": "node scripts/verify-workspace-invitations.js",
    "verify:workspace-migration": "node scripts/verify-workspace-migration.js",
    "verify:data-repair": "node scripts/verify-data-repair.js",
    "verify:data-retention": "node scripts/verify-data-retention.js",
    "verify:review-concurrency": "node scripts/verify-review-concurrency.js",
    "verify:ledger-acknowledgement": "node scripts/verify-ledger-acknowledgement.js",
    "verify:ledger-reference-isolation": "node scripts/verify-ledger-reference-isolation.js",
    "verify:hai-snapshot": "node scripts/verify-hai-snapshot.js",
    "verify:hai-http": "node scripts/verify-hai-http.js",
    "verify:backup-restore": "node scripts/verify-backup-restore.js",
    "verify:follow-up-integrity": "node scripts/verify-follow-up-integrity.js",
    "verify:trello-reconciliation": "node scripts/verify-trello-reconciliation.js",
    "verify:trello-reconciliation-queue": "node scripts/verify-trello-reconciliation-queue.js",
    "verify:trello-execution-effects": "node scripts/verify-trello-execution-effects.js",
    "verify:trello-webhooks": "node scripts/verify-trello-webhook-integrity.js",
    "verify:trello-list-index": "node scripts/verify-trello-list-index.js",
    "verify:connector-recovery": "node scripts/verify-connector-sync-recovery.js",
    "verify:connector-lifecycle": "node scripts/verify-connector-account-lifecycle.js",
    "verify:packaged": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-packaged-release.ps1",
    "doctor": "node scripts/doctor.js",
    "doctor:json": "node scripts/doctor.js --json",
    "support:bundle": "node scripts/support-bundle.js",
    "profile:startup": "node scripts/profile-startup.js",
    "profile:portfolio-scale": "node scripts/profile-portfolio-scale.js",
    "check:ci": "npm run lint && npm run check:route-authorization && npm test -- --runInBand && npm run evaluate:recommendations",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "lint": "eslint src/**/*.js scripts/*.js desktop/*.js"
  },
  "keywords": [
    "trello",
    "project-management",
    "ai",
    "automation",
    "nlp",
    "analytics",
    "team-management"
  ],
  "author": "Noodzakelijk Online",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.20.0",
    "body-parser": "^2.3.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "mongoose": "^9.11.2",
    "natural": "^8.1.1",
    "node-schedule": "^2.1.1",
    "openai": "^7.35.0",
    "pdfkit": "^0.20.2",
    "trello.js": "^2.3.0",
    "winston": "^3.19.0"
  },
  "overrides": {
    "qs": "6.16.0",
    "global-agent": "4.1.3",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "4.3.2"
    }
  },
  "devDependencies": {
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.13.0",
    "espree": "^11.2.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "jsdom": "^30.1.3"
  },
  "engines": {
    "node": ">=26.12.1"
  },
  "build": {
    "appId": "online.noodzakelijk.sneup",
    "productName": "Sneup",
    "icon": "assets/sneup.ico",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "public/**/*",
      "src/**/*",
      "package.json",
      ".env.example",
      "!node_modules/natural/lib/natural/{analyzers,brill_pos_tagger,classifiers,distance,inflectors,ngrams,normalizers,phonetics,spellcheck,transliterators,trie,wordnet}/**/*",
      "!node_modules/natural/lib/natural/{tokenizers,stemmers}/aggressive_tokenizer_*.js",
      "!node_modules/{apparatus,memjs,pg,redis,stopwords-iso,sylvester,uuid,wordnet-db}/**/*",
      "!node_modules/natural/node_modules/{apparatus,memjs,pg,redis,stopwords-iso,sylvester,uuid,wordnet-db}/**/*",
      "!node_modules/natural/node_modules/{dotenv,mongoose}/**/*"
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "signExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Sneup-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sneup"
    }
  }
}
