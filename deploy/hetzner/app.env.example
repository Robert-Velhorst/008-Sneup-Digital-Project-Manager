# Optional app-only settings. Keep actual credentials in ignored app.env.
# Select that file with SNEUP_APP_ENV_FILE=./app.env in the deployment .env.
# Use the repository-root .env.example for supported connector/client settings.
# Do not place MongoDB root credentials or unrelated host secrets here.
# Core authentication, storage, origin, bind, and tunnel settings in Compose
# override this file so optional account configuration cannot weaken them.
