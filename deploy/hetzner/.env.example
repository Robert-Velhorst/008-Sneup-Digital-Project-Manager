SNEUP_DOMAIN=sneup.example.com
SNEUP_IMAGE_TAG=local
# Optional connector/notification/model settings; path is relative to compose.yaml.
# Copy app.env.example to app.env before changing this to ./app.env.
SNEUP_APP_ENV_FILE=./app.env.example
# Generate each secret separately with: openssl rand -hex 32
SNEUP_API_KEY=
SNEUP_API_TOKEN_PEPPER=
SNEUP_SESSION_TOKEN_PEPPER=
SNEUP_INVITE_TOKEN_PEPPER=
CONNECTOR_ENCRYPTION_KEY=
CONNECTOR_STATE_SECRET=
SNEUP_MONGO_ROOT_PASSWORD=
SNEUP_MONGO_PASSWORD=
# Initial deployment is analysis-only until owner-controlled provider acceptance.
SNEUP_PROVIDER_WRITES_DISABLED=true
TRELLO_API_KEY=
TRELLO_API_TOKEN=
TRELLO_WEBHOOK_SECRET=
# Change these together; the proxy IP must be outside the dynamic allocation range.
SNEUP_PROXY_SUBNET=10.255.108.0/24
SNEUP_PROXY_IP=10.255.108.2
SNEUP_PROXY_DYNAMIC_RANGE=10.255.108.128/25
# This independent database network must also avoid existing routes and networks.
SNEUP_DATA_SUBNET=10.255.109.0/24
